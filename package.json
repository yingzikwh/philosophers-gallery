{
  "name": "philosophers-gallery-local",
  "version": "1.0.0",
  "private": true,
  "description": "哲思殿堂 - 哲学家画廊与 PVE 闯关知识对战",
  "author": "哲思殿堂",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 3015 --host 0.0.0.0 --strictPort",
    "dev:server": "node server/index.js",
    "dev:all": "concurrently -n \"前端,后端\" -c \"blue,green\" \"npm:dev\" \"npm:dev:server\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3015 --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "pack:desktop": "node scripts/pack-desktop.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/router-plugin": "^1.167.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "asar": "^3.2.0",
    "concurrently": "^9.1.2",
    "electron": "^30.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  }
}
