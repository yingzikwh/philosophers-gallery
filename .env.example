# ============================================================
# 哲思殿堂 · 环境配置模板
#
# 用法：复制本文件为 .env 并填写真实值
#   Windows    :  copy .env.example .env
#   Linux/macOS:  cp .env.example .env
#
# 说明：
#   - .env 已被 .gitignore 排除，不会入库；请勿将 API Key 硬编码进代码
#   - 解析规则见 server/index.js：仅识别行首 # 注释，按首个 = 分割，值会自动去除首尾引号
#   - 已存在的系统环境变量优先级高于本文件（代码仅在变量未设置时才采用 .env 值）
# ============================================================

# ---------- 大模型对话（必填）----------
# 你的 API Key。未填写时哲学家画廊仍可正常浏览，但 AI 对话 / PVE 闯关评分不可用。
# start.bat 会检测 "在此填入" 占位符并给出提醒。
OPENAI_API_KEY=在此填入你的API_Key

# OpenAI 兼容接口的基础地址，按服务商选择：
#   OpenAI     : https://api.openai.com/v1
#   DeepSeek   : https://api.deepseek.com/v1
#   Moonshot   : https://api.moonshot.cn/v1
#   通义千问   : https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称，按服务商选择：gpt-4o-mini / deepseek-chat / moonshot-v1-8k / qwen-plus
OPENAI_MODEL=gpt-4o-mini

# ---------- 本地后端服务 ----------
# 后端监听端口。修改后需同步 vite.config.ts 中 /sb-api 与 /api 的代理目标。
PORT=3016

# ---------- AI 配音 TTS（可选）----------
# 需兼容 OpenAI /audio/speech 接口，例如 https://api.siliconflow.cn/v1
# 留空时 /api/tts 返回 501，前端自动回退浏览器内置朗读（Web Speech API）。
TTS_BASE_URL=
# 留空则复用 OPENAI_API_KEY
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ---------- 数据目录（通常无需配置）----------
# 闯关进度等本地数据的存放目录。桌面版（Electron）启动时会自动注入为
# userData/data，请勿在 .env 中设置，以免覆盖自动逻辑。
# ZS_DATA_DIR=
